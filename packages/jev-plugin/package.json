{
  "name": "@ai-girlfriend/jev-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.mts",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "import": "./index.mjs"
    },
    "./adapter": {
      "types": "./adapter.d.mts",
      "import": "./adapter.mjs"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "*.mjs",
    "*.d.mts",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/adapter.test.mjs test/service.test.mjs",
    "test:dsh": "node --test test/dsh-load.test.mjs"
  },
  "dependencies": {
    "@ai-girlfriend/decision-core": "file:../decision-core",
    "@typesafe-ai/sdk": "0.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.3-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
